# =========================================================================
# COOPNEX FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =========================================================================

# -------------------------------------------------------------------------
# 1. API BACKEND URL
# -------------------------------------------------------------------------
# Leave empty if using Vite dev proxy (/api), or specify deployed backend URL
VITE_API_URL=

# -------------------------------------------------------------------------
# 2. FIREBASE PHONE AUTHENTICATION (REAL CELLULAR SMS OTP)
# -------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -------------------------------------------------------------------------
# 3. EMAILJS EMAIL AUTHENTICATION (TWO UNIVERSAL TEMPLATES)
# -------------------------------------------------------------------------
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_VERIFICATION_TEMPLATE_ID=
VITE_EMAILJS_RESET_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

