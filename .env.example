# =========================================================================
# COOPNEX ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env in respective directories and populate your actual credentials.
# NEVER commit .env files containing real secrets to GitHub.
# =========================================================================

# Backend Service
PORT=5000
NODE_ENV=production
MONGODB_URI=
JWT_SECRET=
OTP_SALT=

# Client URLs (for CORS in production)
FRONTEND_URL=

# AI Service (Python FastAPI)
AI_SERVICE_URL=

# Real Email OTP Service (EmailJS Universal Templates)
EMAILJS_SERVICE_ID=
EMAILJS_VERIFICATION_TEMPLATE_ID=
EMAILJS_RESET_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Optional SMTP Fallback
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Payments (Sandbox / Production)
PAYMENT_GATEWAY_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Frontend Environment Variables
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_VERIFICATION_TEMPLATE_ID=
VITE_EMAILJS_RESET_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=


