RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
VITE_AI_BASE_URL=http://localhost:8000

