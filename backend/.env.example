# =========================================================================
# COOPNEX BACKEND ENVIRONMENT CONFIGURATION (.env)
# =========================================================================
PORT=5000
MONGODB_URI=mongodb://localhost:27017/sahakari_seva
JWT_SECRET=super_secret_coopnex_production_jwt_key_2026
OTP_SALT=coopnex_secure_salt_2026

# =========================================================================
# REAL EMAIL OTP VIA EMAILJS (TWO UNIVERSAL TEMPLATES: VERIFY & RESET)
# =========================================================================
# Both Customer and Worker share the exact same two templates:
# Template 1: EMAILJS_VERIFICATION_TEMPLATE_ID (Registration & re-verification)
# Template 2: EMAILJS_RESET_TEMPLATE_ID (Password Reset OTP)
# Template Dynamic Variables: {{name}}, {{email}}, {{otp}}, {{expiry}}, {{app_name}}
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_VERIFICATION_TEMPLATE_ID=your_verification_template_id
EMAILJS_RESET_TEMPLATE_ID=your_reset_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key_optional

# =========================================================================
# OPTIONAL SMTP FALLBACK (Gmail / Outlook / SendGrid)
# =========================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
