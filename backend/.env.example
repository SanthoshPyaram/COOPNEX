# =========================================================================
# COOPNEX BACKEND CONFIGURATION TEMPLATE (.env.example)
# Copy to .env and provide your actual configuration values.
# NEVER commit actual secrets, passwords, or connection strings.
# =========================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas in Production, Local in Development)
# Production: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sahakari_seva?retryWrites=true&w=majority
# Development: mongodb://localhost:27017/sahakari_seva
MONGO_URI=
MONGODB_URI=

# Authentication Secrets
JWT_SECRET=
OTP_SALT=

# CORS & Frontend Origins (Comma-separated)
FRONTEND_URL=https://santhoshpyaram.github.io

# EmailJS Universal OTP Credentials
EMAILJS_SERVICE_ID=
EMAILJS_VERIFICATION_TEMPLATE_ID=
EMAILJS_RESET_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
