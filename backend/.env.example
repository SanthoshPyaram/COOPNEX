# =========================================================================
# COOPNEX BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =========================================================================
PORT=5000
NODE_ENV=production
MONGODB_URI=
JWT_SECRET=
OTP_SALT=

# Client URLs (for CORS in production, comma-separated)
FRONTEND_URL=

# AI Service Connection
AI_SERVICE_URL=

# =========================================================================
# REAL EMAIL OTP VIA EMAILJS (TWO UNIVERSAL TEMPLATES: VERIFY & RESET)
# =========================================================================
# Template 1: EMAILJS_VERIFICATION_TEMPLATE_ID (Registration & re-verification)
# Template 2: EMAILJS_RESET_TEMPLATE_ID (Password Reset OTP)
EMAILJS_SERVICE_ID=
EMAILJS_VERIFICATION_TEMPLATE_ID=
EMAILJS_RESET_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# =========================================================================
# OPTIONAL SMTP FALLBACK (Gmail / Outlook / SendGrid)
# =========================================================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# =========================================================================
# PAYMENTS (Razorpay / Escrow)
# =========================================================================
PAYMENT_GATEWAY_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# =========================================================================
# DEMO CREDENTIAL OVERRIDES (Optional for automated testing)
# =========================================================================
WORKER_DEMO_EMPLOYEE_ID=
WORKER_DEMO_PASSWORD=
ADMIN_DEMO_EMAIL=
ADMIN_DEMO_PASSWORD=
CUSTOMER_DEMO_EMAIL=
CUSTOMER_DEMO_PASSWORD=

